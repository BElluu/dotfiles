case $- in
    *i*) ;;
      *) return;;
esac

HISTCONTROL=ignoreboth

shopt -s histappend

HISTSIZE=1000
HISTFILESIZE=2000

shopt -s checkwinsize

[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
    debian_chroot=$(cat /etc/debian_chroot)
fi

case "$TERM" in
    xterm-color|*-256color) color_prompt=yes;;
esac

if [ -n "$force_color_prompt" ]; then
    if [ -x /usr/bin/tput ] && tput setaf 1 >&/dev/null; then
	color_prompt=yes
    else
	color_prompt=
    fi
fi

if [ "$color_prompt" = yes ]; then
    PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
else
    PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
fi
unset color_prompt force_color_prompt

case "$TERM" in
xterm*|rxvt*)
    PS1="\[\e]0;${debian_chroot:+($debian_chroot)}\u@\h: \w\a\]$PS1"
    ;;
*)
    ;;
esac

if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi

alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'

if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

# ── Środowisko (uporządkowane) ───────────────────────────────────────────────
eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"

export DOTNET_ROOT="$HOME/.dotnet"
export BUN_INSTALL="$HOME/.bun"
export EDITOR=nvim
export VISUAL=nvim

# Jedna definicja PATH zamiast siedmiu doklejeń (były w tym duplikaty)
path_prepend() { case ":$PATH:" in *":$1:"*) ;; *) PATH="$1:$PATH" ;; esac; }
path_prepend "$HOME/.dotnet/tools"
path_prepend "$HOME/.dotnet"
path_prepend "$BUN_INSTALL/bin"
path_prepend "$HOME/go/bin"
path_prepend "$HOME/.local/bin"
export PATH

# ── nvm — leniwie ────────────────────────────────────────────────────────────
# `source nvm.sh` kosztuje ~0.85 s i odpalało się przy KAŻDYM panelu tmuxa.
# Do PATH trafia od razu domyślna wersja node (żeby node/npm/claude działały),
# a samo `nvm` doczytuje się dopiero przy pierwszym użyciu.
export NVM_DIR="$HOME/.nvm"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  __nvm_default=$(cat "$NVM_DIR/alias/default" 2>/dev/null)
  for __d in "$NVM_DIR/versions/node/v${__nvm_default#v}"*/bin; do
    [ -d "$__d" ] && path_prepend "$__d" && break
  done
  unset __nvm_default __d
  nvm() {
    unset -f nvm
    . "$NVM_DIR/nvm.sh"
    [ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"
    nvm "$@"
  }
fi

# ── asdf ─────────────────────────────────────────────────────────────────────
[ -s "$HOME/.asdf/asdf.sh" ] && . "$HOME/.asdf/asdf.sh"
[ -s "$HOME/.asdf/completions/asdf.bash" ] && . "$HOME/.asdf/completions/asdf.bash"

# ── Historia wspólna dla paneli ──────────────────────────────────────────────
# Bez tego każdy panel tmuxa nadpisywał historię pozostałych przy wyjściu.
HISTSIZE=100000
HISTFILESIZE=200000
HISTCONTROL=ignoreboth:erasedups
shopt -s histappend cmdhist
PROMPT_COMMAND="history -a; ${PROMPT_COMMAND:-}"

# ── Narzędzia ────────────────────────────────────────────────────────────────
[ -r /usr/share/doc/fzf/examples/key-bindings.bash ] && . /usr/share/doc/fzf/examples/key-bindings.bash
export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border --info=inline'
export FZF_DEFAULT_COMMAND='fdfind --type f --hidden --exclude .git'

command -v zoxide >/dev/null && eval "$(zoxide init bash)"
command -v atuin  >/dev/null && eval "$(atuin init bash --disable-up-arrow)"

alias ll='ls -lah --color=auto'
alias fd='fdfind'
alias lg='lazygit'
alias v='nvim'
alias gs='git status -sb'
alias tl='tmux list-sessions'

[ -r "$HOME/.bashrc.local" ] && . "$HOME/.bashrc.local"
